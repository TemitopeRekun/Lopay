# Template for android/keystore.properties, which holds the release signing
# credentials and is gitignored. Copy this file to keystore.properties and fill in
# the real values; this one must never contain them.
#
# Without it, `gradlew assembleRelease` still succeeds — it just produces an
# UNSIGNED apk, because the signing config is skipped when neither this file nor
# the LOPAY_* environment variables are present.
#
# The keystore itself lives OUTSIDE this repo on purpose. Do not copy it in.
#
# Forward slashes even on Windows: a backslash is an escape character in a
# .properties file, so C:\Users\... would be read as C:Users...

storeFile=C:/path/to/your-release-key.jks
storePassword=
keyAlias=your-key-alias
keyPassword=

# CI has no file to read, so the build falls back to these environment variables:
#   LOPAY_STORE_FILE, LOPAY_STORE_PASSWORD, LOPAY_KEY_ALIAS, LOPAY_KEY_PASSWORD
# Ship the keystore to CI as a base64-encoded secret and decode it at build time.
