# Copy to `.env.local` for local development. Every var here is read at BUILD
# time by Vite and inlined into the client bundle, so:
#   - nothing secret belongs in this file, and
#   - changing one on a host (Netlify, etc.) needs a fresh build to take effect.
#
# On Netlify these are set in netlify.toml under [build.environment]; the
# Netlify UI can override them per site or per deploy context.

# Base URL of the lopay-backend API. Also drives `connect-src` in the generated
# CSP (see build/csp.ts), so a wrong value fails closed with blocked requests.
# Local backend: http://localhost:3001
VITE_API_URL=https://lopay-backend.onrender.com

# Supabase project URL — must match the backend's SUPABASE_URL.
#
# Receipt uploads do NOT go through the API: the backend mints a signed upload
# URL and the browser PUTs the file straight to this origin. It therefore has to
# be in the CSP's `connect-src` (see build/csp.ts) or every installment receipt
# upload fails with an opaque "Failed to fetch". `vite dev` injects no CSP at
# all, so a missing value here breaks ONLY the built app. Any build against a
# non-localhost API refuses to complete without it.
#
# Not a secret: the project URL is public. The service-role key that grants
# access to it stays on the backend and must never appear in a VITE_* var.
VITE_SUPABASE_URL=https://kmrfnbvkzauiaseslblt.supabase.co

# Auth transport for the web build: `bearer` (default) or `cookie`.
# Leave unset. Cookie mode is the M2 dual-path opt-in and is still pending
# staging verification; the native Capacitor shell always uses bearer.
# VITE_WEB_AUTH_MODE=cookie

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (web push)
# ---------------------------------------------------------------------------
# From Firebase console → Project settings, for project `lopay-auth` — the SAME
# project the backend's FIREBASE_* service account belongs to. A token minted
# against a different project cannot be sent to by that service account, and the
# failure surfaces as a push that is accepted and never delivered.
#
# None of these is a secret. The web config and the VAPID *public* key are
# designed to ship to browsers; the private half never leaves Google. The
# credential that can SEND a push is the backend's FIREBASE_PRIVATE_KEY.
#
# All five required vars must be present or push is disabled wholesale — a
# partial config makes FCM fail with an opaque `messaging/token-subscribe-failed`
# rather than a useful error, so `resolvePushConfig` treats it as absent.
#
# General → Your apps → Web app → SDK setup and configuration:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=lopay-auth
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — defaults to <projectId>.firebaseapp.com. Messaging never uses it.
# VITE_FIREBASE_AUTH_DOMAIN=lopay-auth.firebaseapp.com

# Cloud Messaging → Web configuration → Web Push certificates → "Key pair".
# Generate one if the section is empty.
VITE_FIREBASE_VAPID_KEY=
